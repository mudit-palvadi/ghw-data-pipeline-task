# Copy this file to `.env` and fill in your values.

# --- Tiger Cloud ------------------------------------------------------------
# Easiest: copy the full connection string from Tiger Console or `tiger db uri`.
TIGER_URI=postgresql://tsdbadmin:YOUR_PASSWORD@YOUR_SERVICE.tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require

# Or set the individual pieces (used when TIGER_URI is not set):
TIGER_HOST=YOUR_SERVICE.tsdb.cloud.timescale.com
TIGER_PORT=YOUR_PORT
TIGER_DB=tsdb
TIGER_USER=tsdbadmin
TIGER_PASSWORD=YOUR_PASSWORD

# --- Twelve Data (only for `--source twelvedata`) ---------------------------
# Free API key from https://twelvedata.com/account/api-keys
TWELVEDATA_API_KEY=
